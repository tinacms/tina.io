          "commit_hash": "787c7a9",
          "commit_link": "https://github.com/tinacms/tinacms/commit/787c7a9daf7740dbfb148d25a74367948bcbaade",
          "gitHubName": "dependabot",
          "gitHubLink": "https://github.com/apps/dependabot"
        },
        {
          "changesDescription": "Rich-text fields can now colour text. A Text Color dropdown now appears next to Highlight in the default toolbar. Fields with a custom `overrides.toolbar` need `'textColor'` added to it. Coloured text saves as a `<span>` with a `color` style, inside any bold, italic, strikethrough or highlight. The palette can be set per field under `overrides.textColors` (a list of `{ label, value }`).",
          "pull_request_number": "7683",
          "pull_request_link": "https://github.com/tinacms/tinacms/pull/7683",
          "commit_hash": "034e88f",
          "commit_link": "https://github.com/tinacms/tinacms/commit/034e88ff9fb8035b1443397b5d981313a44fa30f",
          "gitHubName": "joshbermanssw",
          "gitHubLink": "https://github.com/joshbermanssw"
        }
      ]
    },
