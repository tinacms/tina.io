# Algolia: the admin key is used by `pnpm create-indices` to write the blog index.
ALGOLIA_APP_ID=***
ALGOLIA_ADMIN_KEY=***

# Optional: blog search in the browser falls back to the public Tina Algolia
# app and search key when these are unset.
GATSBY_ALGOLIA_APP_ID=
GATSBY_ALGOLIA_SEARCH_KEY=

MAILCHIMP_ADDRESS=***
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
HUBSPOT_TEAMS_FORM_ID=***
HUBSPOT_PORTAL_ID=***
GTM_ID=***
SSW_GTM_ID=
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
NEXT_PUBLIC_TINA_BRANCH=
TINA_SEARCH_TOKEN=
GISCUS_ORG=***
GISCUS_REPO_NAME=***
GISCUS_REPO_ID=***
GISCUS_CATEGORY=***
GISCUS_CATEGORY_ID=***
GISCUS_THEME_URL=***
SENDGRID_API_KEY=***
SENDGRID_FROM_EMAIL=***
CONTACT_FORM_TO=***
YOUTUBE_API_KEY=***

# Optional: raises the GitHub API rate limit for the star count and repo metadata routes.
GITHUB_STAR_TOKEN=

# Optional: Chatbase bot ID for the site chatbot.
NEXT_PUBLIC_CHATBASE_BOT_ID=

# Optional: only used by the auto-translate GitHub workflow.
TINA_OPENAI_API_KEY=

# Optional: set to true on low-RAM machines to cut dev server memory
# (~8.7GB -> ~7.6GB peak) at the cost of ~13s per dev-server restart.
LOW_MEMORY=false

# Optional: when set, /docs and /zh/docs rewrite to this URL (see next.config.js).
# When unset, no docs rewrites are added.
DOCS_UPSTREAM_URL=
